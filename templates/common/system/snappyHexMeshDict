FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "caseParameters"

castellatedMesh true;
snap            true;
addLayers       true;

geometry
{
    text
    {
        type    triSurfaceMesh;
        file    "text.stl";
    }

    near
    {
        type    box;
        min     $nearMin;
        max     $nearMax;
    }
}

castellatedMeshControls
{
    maxLocalCells       10000000;
    maxGlobalCells      100000000;
    minRefinementCells  0;
    maxLoadUnbalance    0.10;
    nCellsBetweenLevels 4;

    features
    (
        {
            file    "text.eMesh";
            level   $levelSurface;
        }
    );

    refinementSurfaces
    {
        text
        {
            level   ($levelSurface $levelSurface);
            patchInfo
            {
                type    wall;
            }
        }
    }

    resolveFeatureAngle 30;

    refinementRegions
    {
        text
        {
            mode    distance;
            levels  $surfaceDistanceLevels;
        }
        near
        {
            mode    inside;
            levels  ((1e15 $levelNear));
        }
    }

    locationInMesh  $locationInMesh;

    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch    3;
    tolerance       2.0;
    nSolveIter      100;
    nRelaxIter      5;

    nFeatureSnapIter    10;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}

// Body-fitted prism layers on the letters; sizes relative to the local
// (surface) cell size, set from the physics in caseParameters
addLayersControls
{
    relativeSizes       true;

    layers
    {
        text
        {
            nSurfaceLayers  $nLayers;
        }
    }

    firstLayerThickness $firstLayerThickness;
    expansionRatio      $layerExpansion;
    minThickness        0.02;

    nGrow               0;
    featureAngle        180;        // extrude round the letter corners too
    slipFeatureAngle    30;
    nRelaxIter          5;
    nSmoothSurfaceNormals 3;
    nSmoothNormals      3;
    nSmoothThickness    10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.5;
    minMedialAxisAngle  90;
    nBufferCellsNoExtrude 0;
    nLayerIter          50;
    nRelaxedIter        20;
}

meshQualityControls
{
    #includeEtc "caseDicts/mesh/generation/meshQualityDict.cfg"
}

mergeTolerance 1e-6;

// ************************************************************************* //
