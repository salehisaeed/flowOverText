FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "<system>/caseParameters"

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform $pRef;

boundaryField
{
    "(bottom|top)"
    {
        type            totalPressure;
        p0              uniform $pRef;
        value           uniform $pRef;
    }
    "(left|right|text)"
    {
        type            fixedFluxPressure;
        value           uniform $pRef;
    }
    "(front|back)"
    {
        type            empty;
    }
}

