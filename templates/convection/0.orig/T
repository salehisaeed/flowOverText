FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "<system>/caseParameters"

dimensions      [0 0 0 1 0 0 0];

internalField   uniform $Tcold;

boundaryField
{
    "(bottom|top)"
    {
        type            inletOutlet;
        inletValue      uniform $Tcold;
        value           uniform $Tcold;
    }
    "(left|right)"
    {
        type            zeroGradient;
    }
    text
    {
        type            fixedValue;
        value           uniform $Thot;
    }
    "(front|back)"
    {
        type            empty;
    }
}

