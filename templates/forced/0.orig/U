FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "<system>/caseParameters"

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform $Uinf;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform $Uinf;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           uniform $Uinf;
    }
    "(top|bottom)"
    {
        type            slip;
    }
    text
    {
        type            noSlip;
    }
    "(front|back)"
    {
        type            empty;
    }
}

